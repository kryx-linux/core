# Description: Library to create and read several archive formats
# URL: https://www.libarchive.org/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: acl bzip2 lzo xz zlib zstd

name=libarchive
version=3.6.2
release=2
source=(https://github.com/libarchive/libarchive/releases/download/v$version/$name-$version.tar.xz)

build() {
	cd $name-$version

	# We're passing --without-xml2, --without-nettle and --without-libb2
	# to avoid linking to libraries which are only available in opt.

	./configure \
		--prefix=/usr \
		--without-xml2 \
		--without-nettle \
		--without-libb2

	make
	make DESTDIR=$PKG install

	# fix pkgconfig file
	sed "/^Requires.private:/s/iconv//" -i $PKG/usr/lib/pkgconfig/libarchive.pc
}
