# Description: An RFC2131-compliant DHCP client daemon
# URL:         http://roy.marples.name/projects/dhcpcd/
# Maintainer:  CRUX System Team, core-ports at crux dot nu
# Depends on:  eudev

name=dhcpcd
version=6.11.0
release=2
source=(http://roy.marples.name/downloads/dhcpcd/$name-$version.tar.xz
    dhcpcd-truncated-packet.patch)

build () {
    cd $name-$version

    patch -p0 <$SRC/dhcpcd-truncated-packet.patch

    ./configure --prefix= \
                --libexecdir=/lib/dhcpcd \
                --dbdir=/var/lib/dhcpcd \
                --sysconfdir=/etc/dhcpcd \
                --os=linux \
                --with-hooks=

    make
    make DESTDIR=$PKG install
    chmod -R u+w $PKG
}
