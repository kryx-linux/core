#
# /etc/profile: system-wide defaults for bash(1) login shells
#

export PATH="/sbin:/usr/sbin:/opt/sbin:/bin:/usr/bin:/opt/bin"

[[ ! -f ~/.inputrc ]] && export INPUTRC="/etc/inputrc"

export LESS="-R"
export PS1="\[\033[1m\]\\$ \[\033[0m\]"
export PS2="\[\033[1m\]> \[\033[0m\]"

umask 022

# End of file
