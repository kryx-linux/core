# Description: Library giving userland programs access to USB devices
# URL:         http://libusbx.org
# Maintainer:  CRUX System Team, core-ports at crux dot nu
# Depends on:  udev

name=libusb
version=1.0.17
release=1
source=(http://downloads.sourceforge.net/project/libusbx/releases/${version%-*}/source/libusbx-$version.tar.bz2)

build () {
    cd libusbx-$version
    
    ./configure --prefix=/usr 
    make
    make DESTDIR=$PKG install
    
    install -d $PKG/lib
    mv $PKG/usr/lib/libusb-1.0.so.* $PKG/lib
    ln -sf ../../lib/$(readlink $PKG/lib/libusb-1.0.so.0) $PKG/usr/lib/libusb-1.0.so
}
